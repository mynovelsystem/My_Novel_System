{
  "manifest_version": 3,
  "name": "MyNovelSystem",
  "version": "4.0.0",
  "description": "Tu sistema personal de lectura y cultivo. Guarda capítulos, calcula Qi, desbloquea recompensas y sube de reino.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://novel-tracker-1d134-default-rtdb.firebaseio.com/*",
    "https://api.callmebot.com/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "omnibox": {
    "keyword": "nt"
  },
  "commands": {
    "continue-latest-novel": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Abrir el último capítulo de la lectura más reciente"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyNovelSystem",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}